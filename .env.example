# Google Sheets API Key phục vụ frontend tra cứu và script kéo snapshot lúc build (scripts/generate-snapshot.ts)
# Lưu ý: Không commit API Key thật vào Git. Tạo .env hoặc .env.local để cấu hình giá trị thật.
VITE_GOOGLE_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY_HERE
GOOGLE_SHEETS_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY_HERE
