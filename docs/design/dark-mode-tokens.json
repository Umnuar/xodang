          "contrastRatio": {
            "onCanvas": "7.52:1 (AAA)",
            "onCard": "7.02:1 (AAA)",
            "onRaised": "6.38:1 (AAA)"
          }
        },
        "text-muted": {
          "value": "#6b6e75",
          "description": "Chữ mờ, placeholder, ký tự gợi ý (dùng cho text lớn >= 18pt hoặc icon >= 3:1)",
          "contrastRatio": {
            "onCanvas": "3.73:1 (Pass UI 3:1)",
            "onCard": "3.48:1 (Pass UI 3:1)",
            "onRaised": "3.16:1 (Pass UI 3:1)"
