          "contrastRatio": {
            "onCanvas": "5.15:1 (AA Pass)",
            "onCard": "4.84:1 (AA Pass)",
            "onRaised": "4.48:1 (AA Pass)"
          }
        },
        "text-on-accent": {
          "value": "#0b100e",
          "description": "Màu chữ trên nút nền accent xanh lá #34d399. TUYỆT ĐỐI không dùng chữ trắng (#ffffff) vì tương phản chỉ đạt 2.08:1 (Fail)",
          "contrastRatio": {
            "onAccent": "9.98:1 (AAA Pass)"
          }
        }
      },
      "accent": {
        "brand-source": "#27ae60",
        "accent-primary": {
          "value": "#34d399",
          "description": "Xanh lá sáng (Emerald 400), khử bão hòa nhẹ giúp chống lóa trên nền tối",
          "contrastRatio": {
            "onCanvas": "9.98:1 (AAA)",
