{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Xơ Đăng Lingua Dark Mode Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens and WCAG AA calibrated specifications for Xơ Đăng Lingua Dark Mode options: Phương án A (Rừng đêm) & Phương án B (Graphite)",
  "metadata": {
    "targetAudience": "Người muốn học tiếng dân tộc, các nhà nghiên cứu và các nhà phát triển bảo tồn ngôn ngữ",
    "brandAnchor": "#27ae60",
    "fontFamily": "Plus Jakarta Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "elevationPrinciple": "Surface lightness elevation (canvas < card < raised/popover), zero background gradients, zero pure black (#000000), zero pure white text (#ffffff)",
    "contrastStandard": "WCAG 2.2 AA (Normal text >= 4.5:1, Large text & UI controls >= 3:1)"
  },
  "themes": {
    "optionA": {
      "id": "forest-midnight",
      "name": "Phương án A: Rừng đêm (Forest Midnight)",
      "character": "Nền đen pha sắc xanh lá rất nhẹ (tinted dark green), hòa quyện cùng bản sắc đại ngàn Tây Nguyên và thương hiệu #27ae60.",
      "surfaces": {
        "bg-canvas": {
          "value": "#0b100e",
          "description": "Nền toàn trang, độ sáng thấp nhất",
          "wcagLuminance": 0.0051
        },
        "bg-card": {
          "value": "#111815",
          "description": "Thẻ nội dung, từ vựng, flashcard, bảng điều khiển",
          "wcagLuminance": 0.0076
        },
        "bg-raised": {
          "value": "#17201c",
          "description": "Phần nổi, ô nhập dữ liệu (input/search), popover, dropdown",
          "wcagLuminance": 0.0125
        },
        "bg-overlay": {
          "value": "rgba(11, 16, 14, 0.85)",
