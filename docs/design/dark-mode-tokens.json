        "warning": {
          "value": "#fbbf24",
          "contrastOnCard": "10.80:1 (AAA)",
          "description": "Ghi chú từ cổ, biến thể phương ngữ, cảnh báo hết giờ"
        },
        "warning-subtle": {
          "value": "rgba(251, 191, 36, 0.12)"
        },
        "info": {
          "value": "#60a5fa",
          "contrastOnCard": "7.09:1 (AAA)",
          "description": "Giải thích ngữ pháp, mẹo ghi nhớ văn hóa"
        },
        "info-subtle": {
          "value": "rgba(96, 165, 250, 0.12)"
        }
      }
    },
    "optionB": {
      "id": "graphite",
      "name": "Phương án B: Graphite (Trung tính / Neutral Dark)",
      "character": "Tông than chì trung tính, không ám sắc tố màu, tập trung tuyệt đối vào sự chính xác của văn bản và công cụ học thuật.",
      "surfaces": {
        "bg-canvas": {
          "value": "#0f1012",
