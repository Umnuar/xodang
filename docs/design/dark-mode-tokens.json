  },
  "componentMappings": {
    "navbar": {
      "background": "var(--color-bg-card)",
      "borderBottom": "1px solid var(--color-border-hairline)",
      "activeTab": "var(--color-accent)",
      "inactiveTab": "var(--color-text-secondary)"
    },
    "searchField": {
      "background": "var(--color-bg-raised)",
      "border": "1px solid var(--color-border-hairline)",
      "text": "var(--color-text-primary)",
      "placeholder": "var(--color-text-muted-calibrated)",
      "focusBorder": "var(--color-accent)",
      "focusRing": "0 0 0 3px rgba(52, 211, 153, 0.2)"
    },
    "entryCard": {
      "background": "var(--color-bg-card)",
      "border": "1px solid var(--color-border-hairline)",
      "headword": "var(--color-text-primary)",
      "phonetics": "var(--color-accent)",
      "definition": "var(--color-text-secondary)",
      "audioButtonBg": "var(--color-accent-subtle)",
      "audioButtonIcon": "var(--color-accent)"
    },
    "flashcard": {
      "frontBackground": "var(--color-bg-card)",
      "backBackground": "var(--color-bg-raised)",
      "border": "1px solid var(--color-border-hairline)",
      "flipTrigger": "var(--color-accent)"
    },
    "quizOption": {
      "defaultBg": "var(--color-bg-raised)",
      "defaultBorder": "1px solid var(--color-border-hairline)",
      "hoverBorder": "1px solid var(--color-accent)",
      "correctBg": "rgba(52, 211, 153, 0.15)",
      "correctBorder": "1px solid var(--color-accent)",
      "wrongBg": "var(--color-semantic-error-subtle)",
      "wrongBorder": "1px solid var(--color-semantic-error)"
    },
    "gameCard": {
      "background": "var(--color-bg-card)",
      "hoverBackground": "var(--color-bg-raised)",
      "badge": "var(--color-accent-subtle)",
      "badgeText": "var(--color-accent)"
    },
    "bottomSheet": {
      "background": "var(--color-bg-raised)",
      "dragHandle": "rgba(255, 255, 255, 0.2)",
      "backdrop": "var(--color-bg-overlay)"
    },
    "buttonPrimary": {
      "background": "var(--color-accent)",
      "text": "var(--color-text-on-accent)",
      "hoverBackground": "var(--color-accent-hover)"
    }
  }
}
