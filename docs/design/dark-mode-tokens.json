        "border-subtle": {
          "value": "rgba(255, 255, 255, 0.12)",
          "description": "Viền hover và phân chia danh mục"
        },
        "border-focus": {
          "value": "#34d399",
          "description": "Vòng focus 2px rõ nét, đáp ứng WCAG 2.2 focus appearance"
        }
      },
      "text": {
        "text-primary": {
          "value": "#e8efe9",
          "description": "Chữ chính, tiêu đề từ vựng, văn bản Xơ Đăng",
          "contrastRatio": {
            "onCanvas": "16.40:1 (AAA)",
            "onCard": "15.41:1 (AAA)",
            "onRaised": "14.25:1 (AAA)"
          }
        },
        "text-secondary": {
          "value": "#9db0a4",
