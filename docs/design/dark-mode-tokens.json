          "contrastRatio": {
            "onCanvas": "4.97:1 (AA Pass)",
            "onCard": "4.72:1 (AA Pass)",
            "onRaised": "4.29:1 (AA Borderline)"
          }
        },
        "text-on-accent": {
          "value": "#0f1012",
