{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Xơ Đăng Lingua Design Tokens",
  "version": "2.0.0",
  "description": "Design tokens comparing Direction A (Quiet Publication) and Direction B (Lean Tool)",
  "sharedConstraints": {
    "spacing": {
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-8": "32px",
      "space-12": "48px"
    },
    "typography": {
      "fontFamily": "Plus Jakarta Sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem"
      },
      "lineHeight": {
        "tight": "1.25",
        "normal": "1.5",
        "relaxed": "1.65"
      },
      "fontWeight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "touchTarget": {
      "minimum": "44px",
      "standard": "48px"
    },
    "iconography": {
      "family": "Lucide SVG",
      "grid": "24px",
      "strokeWidth": "2px",
      "color": "currentColor"
    }
  },
  "directionA": {
    "name": "Phương án A: Ấn phẩm yên tĩnh (Quiet Publication)",
    "philosophy": "Phong cách sách in văn bản học thuật cao cấp, nhã nhặn, tôn trọng sự tập trung, chống mỏi mắt cho người học và nhà nghiên cứu.",
    "light": {
      "bgCanvas": "#FBFBFA",
      "bgSurface": "#FFFFFF",
      "bgSurfaceElevated": "#F4F4F0",
      "bgSurfaceHover": "#F5F5F3",
      "textPrimary": "#1C1917",
      "textSecondary": "#57534E",
      "textTertiary": "#78716C",
      "borderSubtle": "#E7E5E4",
      "borderDefault": "#D6D3D1",
      "borderFocus": "#1E7E48",
      "colorPrimary": "#1E7E48",
      "colorPrimaryHover": "#166534",
      "colorPrimaryLight": "#E8F5E9",
      "colorSecondary": "#C05621",
      "colorSecondaryLight": "#FEEBC8",
      "colorSuccess": "#16A34A",
      "colorDanger": "#DC2626",
      "shadowSm": "0 1px 2px rgba(0, 0, 0, 0.04)",
      "radiusSm": "4px",
      "radiusMd": "6px",
      "radiusLg": "8px",
      "radiusFull": "9999px"
    },
    "dark": {
      "bgCanvas": "#18181B",
      "bgSurface": "#27272A",
      "bgSurfaceElevated": "#3F3F46",
      "bgSurfaceHover": "#3F3F46",
      "textPrimary": "#FAFAFA",
      "textSecondary": "#D4D4D8",
      "textTertiary": "#A1A1AA",
      "borderSubtle": "#3F3F46",
      "borderDefault": "#52525B",
      "borderFocus": "#4ADE80",
      "colorPrimary": "#4ADE80",
      "colorPrimaryHover": "#86EFAC",
      "colorPrimaryLight": "#064E3B",
      "colorSecondary": "#FB923C",
      "colorSecondaryLight": "#7C2D12",
      "colorSuccess": "#22C55E",
      "colorDanger": "#EF4444",
      "shadowSm": "0 1px 2px rgba(0, 0, 0, 0.3)",
      "radiusSm": "4px",
      "radiusMd": "6px",
      "radiusLg": "8px",
      "radiusFull": "9999px"
    }
  },
  "directionB": {
    "name": "Phương án B: Công cụ gọn (Lean Tool)",
    "philosophy": "Phong cách công cụ kỹ thuật và tài liệu phát triển (developer docs / Wiktionary), mật độ thông tin cao vừa phải, phẳng 100%, 0 bóng đổ.",
    "light": {
      "bgCanvas": "#FFFFFF",
      "bgSurface": "#F4F4F5",
      "bgSurfaceElevated": "#FFFFFF",
      "bgSurfaceHover": "#ECECED",
      "textPrimary": "#09090B",
      "textSecondary": "#52525B",
      "textTertiary": "#71717A",
      "borderSubtle": "#E4E4E7",
