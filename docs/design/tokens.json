      "colorPrimaryHover": "#2DD4BF",
      "colorPrimaryLight": "#134E4A",
      "colorSecondary": "#22C55E",
      "colorSecondaryLight": "#14532D",
      "colorSuccess": "#22C55E",
      "colorDanger": "#F43F5E",
      "shadowSm": "none",
      "radiusSm": "2px",
