{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "XeDang Educational Design Tokens",
  "version": "1.0.0",
  "theme": {
    "color": {
      "light": {
        "primary": {
          "base": "#1e7e48",
          "hover": "#17653a",
          "active": "#114d2b",
          "container": "#e8f5e9",
          "onPrimary": "#ffffff"
        },
        "secondary": {
          "base": "#c05621",
          "hover": "#9c4215",
          "container": "#feebc8",
          "onSecondary": "#ffffff"
        },
        "tertiary": {
          "base": "#2b6cb0",
          "hover": "#2c5282",
          "container": "#ebf8ff",
          "onTertiary": "#ffffff"
        },
        "background": {
          "canvas": "#f8fafc",
          "surface": "#ffffff",
          "surfaceHover": "#f1f5f9",
          "surfaceElevated": "#ffffff"
        },
        "text": {
          "primary": "#0f172a",
          "secondary": "#475569",
          "tertiary": "#64748b",
          "inverse": "#f8fafc"
        },
        "border": {
          "subtle": "#e2e8f0",
          "default": "#cbd5e1",
          "focus": "#1e7e48"
        },
        "feedback": {
          "success": "#16a34a",
          "warning": "#d97706",
          "danger": "#dc2626",
          "info": "#0284c7"
        }
      },
      "dark": {
        "primary": {
          "base": "#4ade80",
          "hover": "#86efac",
          "active": "#22c55e",
          "container": "#064e3b",
          "onPrimary": "#052e16"
        },
        "secondary": {
          "base": "#fb923c",
          "hover": "#fdba74",
          "container": "#7c2d12",
          "onSecondary": "#431407"
        },
        "tertiary": {
          "base": "#60a5fa",
          "hover": "#93c5fd",
          "container": "#1e3a8a",
          "onTertiary": "#0c4a6e"
        },
        "background": {
          "canvas": "#0f172a",
          "surface": "#1e293b",
          "surfaceHover": "#334155",
          "surfaceElevated": "#243248"
        },
        "text": {
          "primary": "#f8fafc",
          "secondary": "#cbd5e1",
          "tertiary": "#94a3b8",
          "inverse": "#0f172a"
        },
        "border": {
          "subtle": "#334155",
          "default": "#475569",
          "focus": "#4ade80"
        },
        "feedback": {
          "success": "#22c55e",
          "warning": "#f59e0b",
          "danger": "#ef4444",
          "info": "#38bdf8"
        }
      }
    },
    "typography": {
      "fontFamily": {
        "headline": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
        "body": "'Be Vietnam Pro', system-ui, -apple-system, sans-serif",
        "mono": "'JetBrains Mono', monospace"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "lineHeight": {
        "tight": "1.25",
        "snug": "1.375",
        "normal": "1.5",
        "relaxed": "1.625"
      },
      "fontWeight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px"
    },
    "borderRadius": {
      "none": "0px",
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "24px",
      "full": "9999px"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.03)",
      "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",
      "glow": "0 0 15px rgba(30, 126, 72, 0.35)"
    },
    "transitions": {
      "fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
      "normal": "250ms cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "350ms cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
}
